variant: fcos
version: 1.7.0
systemd:
  units:
  - name: getty@tty1.service
    dropins:
    - name: autologin-core.conf
      contents: |
        [Service]
        ExecStart=-/usr/sbin/agetty --autologin core --noclear %I $TERM
  - name: run-k3s-prereq-installer.service
    enabled: true
    contents: nil
  - name: run-k3s-installer.service
    enabled: true
    contents: nil
storage:
  files:
    - path: /etc/hostname
      mode: 0x644
      overwrite: true
      contents:
        inline: # filled in
    - path: /usr/local/bin/run-k3s-prereq-installer
      mode: 0x755
      contents: # filled in
    - path: /usr/local/bin/run-k3s-installer
      mode: 0x755
      contents: # filled in
passwd:
  users:
    - name: core
      ssh_authorized_keys: [] # filled in
